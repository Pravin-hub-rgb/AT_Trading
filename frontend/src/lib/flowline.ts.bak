// Flow-Line — TWO SYSTEMS side-by-side:
//
//   🟠 ORANGE = computeFlowLine()     → MANUAL_PIVOTS (user-defined, ground truth)
//   ⚪ WHITE  = computeAlgoFlowLine() → ALGO (simple break follower, learning)
//
// Naya date mark karna ho toh MANUAL_PIVOTS mein rows jodo.

export interface FlowSegment {
  dir: "B" | "S";
  startIdx: number;
  startPx: number;
  endIdx: number;
  endPx: number;
}

interface FlowCandle {
  date: string;
  open: number;
  high: number;
  low: number;
  close: number;
}

// ===== GROUND TRUTH: user-defined manual pivots =====
const MANUAL_PIVOTS: Record<string, { time: string; kind: "H" | "L" }[]> = {
  "2026-08-21": [
    { time: "09:15", kind: "H" },
    { time: "09:20", kind: "L" },
    { time: "09:25", kind: "H" },
    { time: "09:30", kind: "L" },
    { time: "09:50", kind: "H" },
    { time: "09:55", kind: "L" },
    { time: "10:00", kind: "H" },
    { time: "10:10", kind: "L" },
    { time: "10:15", kind: "H" },
    { time: "10:20", kind: "L" },
    { time: "10:30", kind: "H" },
    { time: "10:35", kind: "L" },
    { time: "10:40", kind: "H" },
    { time: "10:45", kind: "L" },
    { time: "10:50", kind: "H" },
    { time: "10:55", kind: "H" },
    { time: "10:55", kind: "L" },
    { time: "11:05", kind: "H" },
    { time: "11:10", kind: "L" },
    { time: "11:15", kind: "H" },
    { time: "11:20", kind: "L" },
    { time: "11:30", kind: "H" },
    { time: "11:45", kind: "L" },
    { time: "11:50", kind: "H" },
    { time: "12:15", kind: "L" },
    { time: "12:20", kind: "H" },
    { time: "12:25", kind: "L" },
    { time: "12:35", kind: "H" },
    { time: "12:40", kind: "L" },
    { time: "12:45", kind: "H" },
    { time: "12:55", kind: "L" },
    { time: "13:05", kind: "H" },
    { time: "13:20", kind: "L" },
    { time: "13:30", kind: "H" },
  ],
};

// ===== 🟠 MANUAL FLOW LINE (ground truth) =====
export function computeFlowLine(candles: FlowCandle[]): FlowSegment[] {
  const byDay = new Map<string, { c: FlowCandle; gIdx: number }[]>();
  candles.forEach((c, gIdx) => {
    const d = c.date.slice(0, 10);
    if (!byDay.has(d)) byDay.set(d, []);
    byDay.get(d)!.push({ c, gIdx });
  });

  const segs: FlowSegment[] = [];
  byDay.forEach((items, dayKey) => {
    const marks = MANUAL_PIVOTS[dayKey];
    if (!marks) return; // unmarked days -> no orange line

    const pts: { idx: number; px: number }[] = [];
    for (const m of marks) {
      const item = items.find((it) => it.c.date.slice(11, 16) === m.time);
      if (!item) continue;
      pts.push({
        idx: item.gIdx,
        px: m.kind === "H" ? item.c.high : item.c.low,
      });
    }

    for (let i = 0; i + 1 < pts.length; i++) {
      const a = pts[i];
      const b = pts[i + 1];
      segs.push({
        dir: b.px >= a.px ? "B" : "S",
        startIdx: a.idx,
        startPx: a.px,
        endIdx: b.idx,
        endPx: b.px,
      });
    }
  });
  return segs;
}

