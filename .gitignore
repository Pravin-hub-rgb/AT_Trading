# dependencies
node_modules/
frontend/node_modules/

# next.js
.next/
out/
frontend/.next/

# env / secrets
backend/.env
.env
.env.local
.env.production

# python
backend/venv/
.venv/
__pycache__/
*.py[cod]

# runtime data
data/
#   The Bybit sets that every registry pin was measured against are NOT here any
#   more. They were, and they were lost, because this rule made them untracked
#   and `git clean -fdx` deletes untracked files. They now live outside the
#   repo at <repo>/../btc_data/{is,oos} - see backend/src/btc/btc_config.py.

# logs
*.log
frontend/*.log

# misc
.DS_Store
*.pkl
live_stuff/.env.example

data/unseen/

# run logs from research harnesses (transient console capture, not artifacts)
*.out.txt
*.err.txt

# scratch module written by the patch-injection harnesses (regenerated per run)
live_stuff/tests/_wick_tmp.py
live_stuff/tests/_pyr_tmp.py
live_stuff/tests/_w1h_gray_tmp.py
live_stuff/tests/_w1h_skip_tmp.py

# scratch output from the backtest harnesses
backtest/tests/_*.txt

# per-build temp modules written by test_experiments_craze._load_module
backtest/tests/_craze_tmp_*.py
backtest/tests/__pycache__/_craze_tmp*.pyc

# Ad-hoc harness output dropped in the REPO ROOT. The project keeps results in
# backtest/tests/_*_results.json; a bare _foo.json at the root is scratch that
# escaped. Ignored rather than deleted, so a run in progress is never swept up by
# a cleanup - but it must not be committed. The number belongs in the registry
# pins or a board doc, not in a root-level blob.
/_*.json
/_*.txt
/_*.py
/_*.ps1
/_*.jsonl

# A file literally named $null or 0 is a PowerShell redirection accident - a
# command that wrote to `> $null` or `> 0` instead of discarding. Both were
# committed before the rules above existed. They are ignored by name because
# they have no pattern that catches them.
$null
/0

# Thirty-two root-level _-prefixed files were tracked before the ignore rules
# above took effect: TypeScript build logs (_ts_*), API snapshots (_api_aug27_*),
# debug scripts (_debug_*, _check_*), run scripts (_run_*.ps1). They are
# untracked, not deleted - the evidence in them is real, but a transient capture
# does not belong in history and the root is not where a build artefact belongs.
# Anything genuinely worth keeping belongs in backtest/tests with a name that
# says what it is.

# Stale engine copies. Each of these is a full snapshot of unified.py written
# by some exp_*.py harness at runtime (_htf2h, _wick, _pyr, the 1h wick arms,
# the v18 ctx pair, the green-r arm). Six of the nine are rewritten every time
# their harness runs, so the committed copy was never the one under test - it
# was a snapshot of an older engine sitting next to the harness. The other
# three are orphans: _pyr_tmp is only ever an in-memory module NAME in
# exp_pyramid_phase2.build_pyr_module, and the two _w1h ones were written once
# by a harness that no longer exists. _w1h_gray_tmp is still cited by name in
# a comment in unified.py as the copy that produced exp_fs_gray; the comment
# is the provenance, the 94 KB file was not.
backtest/tests/_*_tmp.py

# exp_registry_snapshot.py 'write' output. A before-snapshot is only useful
# against the change it was taken for; once that change is committed the file
# is stale and regenerating it is one command. The result snapshots that ARE
# evidence - _pinverify_results.json, _pinrefresh.json - are tracked.
backtest/tests/_registry_before.json

# The results database. Rebuildable from the registry + the result JSONs with
# exp_resultsdb.py ingest, so it is generated rather than tracked. WAL and SHM
# are SQLite's own sidecar files.
backtest/tests/results.db
backtest/tests/results.db-wal
backtest/tests/results.db-shm

# Commit-message scratch files. These are written, used and deleted in one step,
# and twice now one was `git add`-ed alongside the change it described because
# the add and the commit ran in the same shell command.
backtest/docs/_msg.txt
backtest/docs/_commit_msg.txt
