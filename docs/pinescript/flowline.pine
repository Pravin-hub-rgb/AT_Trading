//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  ZIGZAG FLOW-LINE — color-aware candle-path structure engine
//
//  Live TradingView port of frontend/src/lib/flowline.ts — the walker that
//  scored 75/75 pivots against hand-marked ground truth
//  (19 · 20 · 21 · 24 · 25 Aug 2026 — NIFTY 50). Rules are timeframe-
//  universal in design; validated extensively on 5-min.
//
//  RULES ENCODED (course S6 + trader spec):
//   • GREEN candle path LOW→HIGH · RED candle path HIGH→LOW  (half-stepping)
//   • Extended legs — same-direction breaks SHIFT the stamp, never print
//   • Opposite break of PREV bar's extreme seals a pivot and flips the leg
//   • INSIDE candles hold a pending far-side edge; the next closed bar
//     resolves them: confirm · skip · volatile double-break (TRUE
//     first-touch order via lower-timeframe intrabars when available;
//     marker-band heuristic is the fallback — band escape marks the
//     stack's far edge)
//   • ONION STACKS — nested insiders buffer rejected outer edges, flushed
//     chronologically when the stack resolves
//   • Leg-extreme memory — a confirming insider can never demote an extreme
//     the leg already owns (intrabar-color gated)
//   • Per-day isolation — each session walks fresh; days are never joined
//   • LIVE-SAFE — state advances on CONFIRMED bars only. Pivots are
//     non-repainting; the forming swing is a separate dashed preview line.
//
//  Docs: docs/pinescript/flowline.md
// ═══════════════════════════════════════════════════════════════════════════
indicator("ZigZag Flow-Line", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ── inputs ────────────────────────────────────────────────────────────────
grpC = "Rendering"
colUp    = input.color(#22c55e, "Up leg",         group = grpC)
colDn    = input.color(#ef4444, "Down leg",       group = grpC)
colPrev  = input.color(#a78bfa, "Forming swing",  group = grpC)
lineW    = input.int(2,          "Line width",    group = grpC, minval = 1, maxval = 5)
showTags = input.bool(false,     "H/L pivot tags", group = grpC)

grpR = "Forming swing (live)"
retracePts = input.float(10.0, "Retrace warning distance (points, 0 = off)", group = grpR, minval = 0.0, step = 1.0)
colWarn    = input.color(#f59e0b, "Retracing color", group = grpR)

grpL = "First-touch order (advanced)"
useLtf = input.bool(true, "Resolve double-break bars via lower-timeframe intrabars", group = grpL,
     tooltip = "When a bar breaks BOTH sides of a pending inside-bar stack, a plain OHLC bar can't tell you which side got hit first — it only has open/high/low/close, never the path. This pulls real lower-timeframe intrabars and walks them in true chronological order to answer that. Falls back to the marker-band heuristic when this is off, the resolution below isn't lower than the chart timeframe, or intrabar data isn't available this far back in history.")
ltfRes = input.timeframe("1", "Intrabar resolution", group = grpL,
     tooltip = "Must be strictly lower than the chart timeframe. Finer = more accurate first-touch order, but TradingView's standard plans cap lower-timeframe requests at roughly 100K intrabars total, so very fine resolutions run out of history sooner (Expert/Ultimate plans get more).")

// ── mutable state (UDT — Pine's way of letting methods mutate state) ──────
type FL
    // leg
    int   dir      = 0        // 0 unseeded · 1 up-leg · -1 down-leg
    float stampPx  = na
    int   stampBar = na
    float prevHigh = na
    float prevLow  = na
    // pending insider / onion stack
    int   pendKind = 0        // 0 none · 1 H-candidate · -1 L-candidate
    int   pendBar  = na
    float pendPx   = na       // far-side edge of the stack
    float pendNear = na       // near-side edge (confirm trigger)
    array<float>  innerPx              // onion peel buffer (init in FL.new)
    array<int>    innerBar
    array<string> innerKd              // layer kinds for the peel records
    // marker band (na = one-sided until both kinds print)
    float bandHi = na
    float bandLo = na
    // running extremes since each side's last push (leg memory)
    float hiPx   = na
    int   hiBar  = na
    bool  hiGrn  = false
    float loPx   = na
    int   loBar  = na
    bool  loRed  = false
    // last pushed pivot (segment anchor)
    bool   pvSet     = false
    int    pvBar     = na
    float  pvPx      = na
    string pvKind    = na
    line   lastSegLn = na

var FL st = FL.new(innerPx = array.new<float>(), innerBar = array.new<int>(), innerKd = array.new<string>())

// ── push pivot: draw segment from previous pivot, refresh anchors ────────
method push(FL fl, float px, string kind, int barIdx) =>
    // ZIGZAG LAWS — dedupe + alternation. Machine-state (band/tracker)
    // resets ALWAYS apply; only the DRAWING layer dedupes/merges.
    bool dup    = fl.pvSet and fl.pvBar == barIdx and fl.pvKind == kind and math.abs(fl.pvPx - px) <= syminfo.mintick
    bool sameKd = fl.pvSet and fl.pvKind == kind
    bool better = kind == "H" ? px > fl.pvPx : px < fl.pvPx

    if kind == "H"
        fl.bandHi := px
        fl.hiPx   := na            // highs restart toward the next L
    else
        fl.bandLo := px
        fl.loPx   := na            // lows restart toward the next H

    // dup / weaker-same-kind -> earlier mark stays (nothing drawn)
    if not dup and sameKd and better
        // stronger same-kind print -> EXTEND the existing leg in place
        if not na(fl.lastSegLn)
            line.set_xy2(fl.lastSegLn, barIdx, px)
        fl.pvBar  := barIdx
        fl.pvPx   := px
    else if not dup and not sameKd
        // alternating kind -> new permanent segment from previous pivot
        if fl.pvSet
            fl.lastSegLn := line.new(fl.pvBar, fl.pvPx, barIdx, px,
                 color = px >= fl.pvPx ? colUp : colDn, width = lineW)
        if showTags
            label.new(barIdx, px, kind,
                 style = kind == "H" ? label.style_label_down : label.style_label_up,
                 color = color.new(color.black, 100),
                 textcolor = kind == "H" ? colUp : colDn, size = size.tiny)
        fl.pvSet   := true
        fl.pvKind  := kind
        fl.pvBar   := barIdx
        fl.pvPx    := px

// ── seal the running stamp as a pivot ────────────────────────────────────
method sealStamp(FL fl) =>
    if not na(fl.stampPx)
        fl.push(fl.stampPx, fl.dir == 1 ? "H" : "L", fl.stampBar)

// ── discard any live insider (dead context dies with the flip) ───────────
method pendingDie(FL fl) =>
    fl.pendKind := 0
    array.clear(fl.innerPx)
    array.clear(fl.innerBar)
    array.clear(fl.innerKd)

// ── close a resolved stack: append its final alternating layer record when
//    peeled, then flush chronologically. Returns [lastPx, lastBar].
//    Layer parity: 1st layer FAR edge, 2nd NEAR, 3rd FAR...
method closeStack(FL fl) =>
    float lastPx  = na
    int   lastBar = na
    if array.size(fl.innerPx) > 0
        // ROLE-BASED edges (see absorption) — no max/min role-swapping.
        bool   wantFar = array.size(fl.innerPx) % 2 == 0
        string knd     = wantFar ? (fl.pendKind == 1 ? "H" : "L") : (fl.pendKind == 1 ? "L" : "H")
        float  rPx     = wantFar ? fl.pendPx : fl.pendNear
        int    rBar    = fl.pendBar
        array.push(fl.innerPx, rPx)
        array.push(fl.innerBar, rBar)
        array.push(fl.innerKd, knd)
        // emit every buffered layer chronologically — INCLUDING the finale
        while array.size(fl.innerPx) > 0
            float  ePx  = array.shift(fl.innerPx)
            int    eBar = array.shift(fl.innerBar)
            string eKd  = array.shift(fl.innerKd)
            fl.push(ePx, eKd, eBar)
        lastPx  := rPx
        lastBar := rBar
    [lastPx, lastBar]

// ── process ONE half-step against the machine ────────────────────────────
method half(FL fl, float sv, bool isLow) =>
    // Mirrors flowline.ts: dispatch on half-TYPE + CURRENT leg dir.
    // A LOW print in an UP-leg breaking prevLow seals the H and flips DOWN;
    // a HIGH print in a DOWN-leg breaking prevHigh seals the L and flips UP.
    if isLow
        if fl.dir == -1
            if sv < fl.stampPx
                fl.stampPx  := sv          // extended leg — shift the stamp
                fl.stampBar := bar_index
        else if sv < fl.prevLow
            fl.sealStamp()                 // up-leg broken - seal its H, flip
            fl.pendingDie()
            fl.dir      := -1
            fl.stampPx  := sv
            fl.stampBar := bar_index
    else
        if fl.dir == 1
            if sv > fl.stampPx
                fl.stampPx  := sv          // extended leg — shift the stamp
                fl.stampBar := bar_index
        else if sv > fl.prevHigh
            fl.sealStamp()                 // down-leg broken - seal its L, flip
            fl.pendingDie()
            fl.dir      := 1
            fl.stampPx  := sv
            fl.stampBar := bar_index

// ── TRUE first-touch order between a pending stack's near/far edges,
//    walked across genuine lower-timeframe intrabars in chronological
//    order. This is the one place in the whole engine that a regular OHLC
//    bar structurally cannot answer on its own — it only ever has open/
//    high/low/close, never the path — so this reaches for a finer data
//    source instead of guessing.
//    Returns  1 = confirm-side touched first (leg continues)
//            -1 = skip/far-side touched first (genuine reversal)
//             0 = neither touched yet (or no usable intrabar data)
//             2 = BOTH sides broke inside ONE intrabar — order is still
//                 irreducibly unknown even at this finer resolution
f_firstTouch(array<float> ihi, array<float> ilo, int pk, float near, float far) =>
    int result = 0
    int n = array.size(ihi)
    if n > 0
        for i = 0 to n - 1
            float hi = array.get(ihi, i)
            float lo = array.get(ilo, i)
            bool cHit = pk == 1 ? lo < near : hi > near
            bool sHit = pk == 1 ? hi > far  : lo < far
            if cHit and sHit
                result := 2
                break
            else if cHit
                result := 1
                break
            else if sHit
                result := -1
                break
    result

// ── lower-timeframe intrabars for THIS bar — historical: the full path
//    once confirmed · live: the partial path so far. Empty arrays when
//    unusable (setting off, ltfRes not below chart TF, or data exhausted
//    this far back in history) — every call site treats an empty/
//    inconclusive result as "fall back to the marker band," never as an
//    error.
bool ltfOk = useLtf and timeframe.in_seconds(ltfRes) > 0 and timeframe.in_seconds(ltfRes) < timeframe.in_seconds(timeframe.period)
array<float> ltfHi = array.new<float>()
array<float> ltfLo = array.new<float>()
if ltfOk
    ltfHi := request.security_lower_tf(syminfo.tickerid, ltfRes, high)
    ltfLo := request.security_lower_tf(syminfo.tickerid, ltfRes, low)

// ═══ CONFIRMED-BAR STATE MACHINE ══════════════════════════════════════════
bool newDay = nz(ta.change(time("D")), 1) != 0

if barstate.isconfirmed

    // ---- day rollover: finalize yesterday's forming swing, wipe per-day --
    if newDay
        if st.pvSet and st.dir != 0 and (st.stampPx != st.pvPx or st.stampBar != st.pvBar)
            line.new(st.pvBar, st.pvPx, bar_index - 1, st.stampPx,
                 color = color.gray, width = 1, style = line.style_dotted)
        st.dir       := 0
        st.pendKind  := 0
        st.pendPx    := na
        st.pendNear  := na
        st.pvSet     := false
        st.bandHi    := na
        st.bandLo    := na
        st.hiPx      := na
        st.hiBar     := na
        st.loPx      := na
        st.loBar     := na
        st.prevHigh  := na
        st.prevLow   := na
        array.clear(st.innerPx)
        array.clear(st.innerBar)
        array.clear(st.innerKd)

    // ---- seed vs machine --------------------------------------------------
    if st.dir == 0
        // SEED — first confirmed bar of the session
        bool greenSeed = close >= open
        st.push(greenSeed ? low : high, greenSeed ? "L" : "H", bar_index)
        st.dir      := greenSeed ? 1 : -1
        st.stampPx  := greenSeed ? high : low
        st.stampBar := bar_index
        st.hiPx     := greenSeed ? high : na
        st.hiBar    := greenSeed ? bar_index : na
        st.hiGrn    := greenSeed
        st.loPx     := greenSeed ? na : low
        st.loBar    := greenSeed ? bar_index : na
        st.loRed    := not greenSeed
        st.prevHigh := high
        st.prevLow  := low
    else
        bool flipped   = false
        bool skipSteps = false

        // ---- 1 · pending pre-eval ----------------------------------------
        if st.pendKind != 0
            float stackHi = math.max(st.pendPx, st.pendNear)
            float stackLo = math.min(st.pendPx, st.pendNear)

            // DOJI LAW — exact open==close candle never joins the stack
            if open != close and high < stackHi and low > stackLo
                // ONION ABSORB — every stack layer contributes ONE alternating
                // zigzag point: layer 1 its FAR edge, layer 2 its NEAR edge,
                // layer 3 FAR again... peel-buffer parity decides.
                // ROLE-BASED edges — pendPx is ALWAYS the far edge, pendNear
                // the near edge (max/min yahan latent pk=L bug tha).
                bool   wantFar = array.size(st.innerPx) % 2 == 0
                string layKind = wantFar ? (st.pendKind == 1 ? "H" : "L") : (st.pendKind == 1 ? "L" : "H")
                float  layPx   = wantFar ? st.pendPx : st.pendNear
                int    layBar  = st.pendBar
                array.push(st.innerPx, layPx)
                array.push(st.innerBar, layBar)
                array.push(st.innerKd, layKind)
                st.pendBar  := bar_index
                st.pendPx   := st.pendKind == 1 ? high : low
                st.pendNear := st.pendKind == 1 ? low : high
                flipped     := true
                skipSteps   := true
            else
                bool confirmHit = st.pendKind == 1 ? low < st.pendNear : high > st.pendNear
                bool skipHit    = st.pendKind == 1 ? high > st.pendPx : low < st.pendPx

                if confirmHit and not skipHit
                    // CONFIRM — seal pre-insider swing; a PEELED stack emits its
                    // remaining alternating layers (continuation keeps the leg);
                    // a plain single insider prints its far edge (+override).
                    st.sealStamp()
                    bool hadPeel = array.size(st.innerPx) > 0
                    [lastPx, lastBar] = st.closeStack()
                    if hadPeel
                        st.stampPx  := lastPx
                        st.stampBar := lastBar
                    else
                        bool useHi = st.pendKind == 1
                        bool okHi  = useHi and not na(st.hiPx) and st.hiPx > st.pendPx
                             and (st.hiBar > st.stampBar or (st.hiBar == st.stampBar and st.hiGrn))
                        bool okLo  = not useHi and not na(st.loPx) and st.loPx < st.pendPx
                             and (st.loBar > st.stampBar or (st.loBar == st.stampBar and st.loRed))
                        float pPx  = okHi ? st.hiPx : okLo ? st.loPx : st.pendPx
                        int   pBar = okHi ? st.hiBar : okLo ? st.loBar : st.pendBar
                        string pKd = useHi ? "H" : "L"
                        st.push(pPx, pKd, pBar)
                        st.stampPx  := pPx
                        st.stampBar := pBar
                    st.pendKind := 0
                else if skipHit and not confirmHit
                    // SINGLE-SIDE FAR BREAK — reversal flip; peeled stacks emit
                    // their remaining alternating layers before the flip.
                    int   pkSave = st.pendKind
                    st.sealStamp()
                    st.closeStack()
                    st.dir      := pkSave == 1 ? 1 : -1
                    st.stampPx  := pkSave == 1 ? high : low
                    st.stampBar := bar_index
                    flipped     := true
                    skipSteps   := true
                    st.pendingDie()
                else if skipHit
                    // DOUBLE-BREAK volatile — both edges broke this bar.
                    // Ask the lower-timeframe intrabars which one is TRUE
                    // first; only fall back to the marker-band guess when
                    // real order genuinely can't be determined.
                    int touch = ltfOk ? f_firstTouch(ltfHi, ltfLo, st.pendKind, st.pendNear, st.pendPx) : 0

                    if touch == 1
                        // CONFIRM really was first — resolve exactly like a
                        // clean CONFIRM. The skip event still happened
                        // later, but that's just this bar's second half-step
                        // now, so leave skipSteps alone and let step 2 catch it.
                        st.sealStamp()
                        bool hadPeel = array.size(st.innerPx) > 0
                        [lastPx, lastBar] = st.closeStack()
                        if hadPeel
                            st.stampPx  := lastPx
                            st.stampBar := lastBar
                        else
                            bool useHi = st.pendKind == 1
                            bool okHi  = useHi and not na(st.hiPx) and st.hiPx > st.pendPx
                                 and (st.hiBar > st.stampBar or (st.hiBar == st.stampBar and st.hiGrn))
                            bool okLo  = not useHi and not na(st.loPx) and st.loPx < st.pendPx
                                 and (st.loBar > st.stampBar or (st.loBar == st.stampBar and st.loRed))
                            float pPx  = okHi ? st.hiPx : okLo ? st.loPx : st.pendPx
                            int   pBar = okHi ? st.hiBar : okLo ? st.loBar : st.pendBar
                            string pKd = useHi ? "H" : "L"
                            st.push(pPx, pKd, pBar)
                            st.stampPx  := pPx
                            st.stampBar := pBar
                        st.pendKind := 0
                    else if touch == -1
                        // SKIP really was first — a genuine reversal.
                        // Resolve exactly like a clean single-side far break.
                        int   pkSave = st.pendKind
                        st.sealStamp()
                        st.closeStack()
                        st.dir      := pkSave == 1 ? 1 : -1
                        st.stampPx  := pkSave == 1 ? high : low
                        st.stampBar := bar_index
                        flipped     := true
                        skipSteps   := true
                        st.pendingDie()
                    else
                        // touch == 0 (no usable intrabar data reached here)
                        // or touch == 2 (both edges broke inside ONE
                        // intrabar — order unknown even there) — marker
                        // band decides, same convention as before.
                        float iLo = math.min(st.pendPx, st.pendNear)
                        float iHi = math.max(st.pendPx, st.pendNear)
                        float effLo = st.dir == -1 ? st.stampPx : na(st.bandLo) ? -1e10 : st.bandLo
                        float effHi = st.dir == 1 ? st.stampPx : na(st.bandHi) ? 1e10 : st.bandHi
                        bool insideBand = iHi <= effHi and iLo >= effLo and high <= effHi and low >= effLo

                        if insideBand
                            // continuation — ride straight to the volatile extreme
                            st.sealStamp()
                            st.dir      := st.pendKind == 1 ? 1 : -1
                            st.stampPx  := st.pendKind == 1 ? high : low
                            st.stampBar := bar_index
                            flipped     := true
                            skipSteps   := true
                            st.pendingDie()
                        else
                            // ESCAPE — mark the stack's far edge; halves walk
                            int   escPk  = st.pendKind
                            st.sealStamp()
                            [escPx, escBar] = st.closeStack()
                            if na(escPx)
                                st.push(st.pendPx, escPk == 1 ? "H" : "L", st.pendBar)
                            st.dir      := escPk == 1 ? -1 : 1
                            st.stampPx  := st.pendNear
                            st.stampBar := st.pendBar
                            st.pendingDie()
                            flipped     := true

        // ---- 2 · half-steps in candle-path order --------------------------
        if not skipSteps
            bool  green = close >= open
            float h1   = green ? low  : high      // prints FIRST
            float h2   = green ? high : low       // prints SECOND
            bool lowFirst = green                      // green prints its LOW first

            st.half(h1, lowFirst)
            st.half(h2, not lowFirst)

        // ---- 3 · running-extreme memory -----------------------------------
        if na(st.hiPx) or high > st.hiPx
            st.hiPx  := high
            st.hiBar := bar_index
            st.hiGrn := close >= open
        if na(st.loPx) or low < st.loPx
            st.loPx  := low
            st.loBar := bar_index
            st.loRed := close < open

        // ---- 4 · insider detection ----------------------------------------
        // DOJI LAW — exact open==close candle never classifies as structure
        if st.pendKind == 0 and not flipped and open != close and high <= st.prevHigh and low >= st.prevLow
            st.pendKind := st.dir == -1 ? 1 : -1
            st.pendBar  := bar_index
            st.pendPx   := st.dir == -1 ? high : low
            st.pendNear := st.dir == -1 ? low : high
            array.clear(st.innerPx)
            array.clear(st.innerBar)
            array.clear(st.innerKd)

        // ---- 5 · roll prior-bar extremes ----------------------------------
        st.prevHigh := high
        st.prevLow  := low

// ═══ FORMING-SWING PREVIEW (every tick — display only, never mutates state)
// SMART GATING — the dashed tip only pokes into the live bar when price is
// genuinely EXTENDING the leg (breaching the stamp extreme). Otherwise it
// stays PINNED at the stamped extreme: no fake follow into weak candles.
// RETRACING: when price pulls back ≥ retracePts from the live extreme, the
// line shifts to the warning color (momentum-break cue).
//
// SOLID-ON-BREAK, tiered by how sure we actually are:
//  1) Plain leg, no pending stack — breaking prevHigh/prevLow is a single
//     monotonic OHLC fact: once true intrabar it cannot un-happen for the
//     rest of this bar. Goes solid immediately, safely.
//  2) Pending stack active, LTF data available — walk the REAL intrabars
//     seen so far and ask which threshold was actually touched first. A
//     true first touch, once observed, can never be un-first-ed by
//     whatever the bar does afterward, so this also locks solid immediately.
//  3) Pending stack active, no LTF data (or a same-intrabar tie) — fall
//     back to watching for a genuine escape of the marker band, which is
//     also monotonic-safe on plain OHLC. Short of that, stay dashed: we're
//     honestly still unsure, and pretending otherwise is how you get a
//     confident line that flips color when the bar actually closes.
var line openLn = na
if st.pvSet and st.dir != 0
    bool  havePending = st.pendKind != 0
    bool  solidLock   = false
    float tgt         = st.stampPx
    int   endBar      = st.stampBar
    color pc          = colPrev

    if not havePending
        // Tier 1 — plain flip trigger (unchanged from before: monotonic,
        // always safe on OHLC alone)
        bool flipBrewing = (st.dir == -1 and high > st.prevHigh) or (st.dir == 1 and low < st.prevLow)
        bool extending   = st.dir == 1 ? high > st.prevHigh : low < st.prevLow
        tgt       := extending ? (st.dir == 1 ? high : low) : st.stampPx
        endBar    := extending ? bar_index : st.stampBar
        solidLock := flipBrewing
        pc        := flipBrewing ? (st.dir == 1 ? colDn : colUp) : colPrev
    else
        int touch = ltfOk ? f_firstTouch(ltfHi, ltfLo, st.pendKind, st.pendNear, st.pendPx) : 0

        if touch == -1
            // Tier 2 — TRUE first touch: skip/far side won. Locked, no
            // matter what the rest of this bar goes on to do.
            solidLock := true
            tgt       := st.pendKind == 1 ? high : low
            endBar    := bar_index
            pc        := st.pendKind == 1 ? colUp : colDn
        else if touch != 1
            // touch == 0 (no data, or nothing touched yet) or touch == 2
            // (tied inside one intrabar) — Tier 3 fallback: has price
            // truly escaped the marker band on plain OHLC? Also monotonic
            // once both sides are genuinely hit.
            float iLo     = math.min(st.pendPx, st.pendNear)
            float iHi     = math.max(st.pendPx, st.pendNear)
            float effLo   = st.dir == -1 ? st.stampPx : na(st.bandLo) ? -1e10 : st.bandLo
            float effHi   = st.dir == 1 ? st.stampPx : na(st.bandHi) ? 1e10 : st.bandHi
            bool  bothHit = (st.pendKind == 1 ? high > st.pendPx  : low < st.pendPx) and
                 (st.pendKind == 1 ? low  < st.pendNear : high > st.pendNear)
            bool  escaped = not (iHi <= effHi and iLo >= effLo and high <= effHi and low >= effLo)
            if bothHit and escaped
                int escPk = st.pendKind
                solidLock := true
                tgt       := st.pendNear
                endBar    := st.pendBar
                pc        := escPk == 1 ? colDn : colUp   // escape keeps the ORIGINAL leg direction
        // touch == 1: confirm-side was genuinely first — the leg isn't
        // flipping, so there's nothing new to lock in; stays dashed/pinned.

    float retrace   = st.dir == 1 ? tgt - close : close - tgt
    bool  retracing = retracePts > 0 and retrace >= retracePts and not solidLock
    color finalC    = solidLock ? pc : retracing ? colWarn : pc
    int   transp    = solidLock ? 0 : 30
    string lnStyle  = solidLock ? line.style_solid : line.style_dashed

    if na(openLn)
        openLn := line.new(st.pvBar, st.pvPx, endBar, tgt,
             color = color.new(finalC, transp), width = lineW, style = lnStyle)
    else
        line.set_xy1(openLn, st.pvBar, st.pvPx)
        line.set_xy2(openLn, endBar, tgt)
        line.set_color(openLn, color.new(finalC, transp))
        line.set_style(openLn, lnStyle)
